---
/**
 * Client-rendered Mermaid block. Pass diagram source (no fences).
 * Set clickable for atlas maps that use Mermaid click → URL.
 * Defers render when inside a closed <details>.
 */
interface Props {
  code: string;
  caption?: string;
  clickable?: boolean;
}

const { code, caption, clickable = false } = Astro.props;
const cleaned = String(code || "")
  .replace(/^```mermaid\s*/i, "")
  .replace(/```$/i, "")
  .trim();
---

<figure
  class:list={["diagram", clickable && "diagram--clickable"]}
  data-mermaid-figure
  data-clickable={clickable ? "true" : "false"}
>
  <pre class="mermaid">{cleaned}</pre>
  {caption ? <figcaption>{caption}</figcaption> : null}
</figure>

<script>
  import mermaid from "mermaid";

  const inits = new WeakSet();

  async function renderFigure(fig) {
    if (inits.has(fig)) return;
    const clickable = fig.getAttribute("data-clickable") === "true";
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: clickable ? "loose" : "strict",
      theme: "neutral",
      fontFamily: "Source Serif 4, Georgia, serif",
      flowchart: { curve: "basis", htmlLabels: true },
    });
    const node = fig.querySelector(".mermaid");
    if (node && !node.getAttribute("data-processed")) {
      await mermaid.run({ nodes: [node] });
    }
    inits.add(fig);
  }

  function schedule(fig) {
    const details = fig.closest("details");
    if (details && !details.open) {
      details.addEventListener(
        "toggle",
        () => {
          if (details.open) renderFigure(fig);
        },
        { once: true }
      );
      return;
    }
    renderFigure(fig);
  }

  function renderAll() {
    document.querySelectorAll("[data-mermaid-figure]").forEach(schedule);
  }

  renderAll();
  document.addEventListener("astro:page-load", renderAll);
</script>
