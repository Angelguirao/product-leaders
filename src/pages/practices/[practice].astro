---
import Base from "../../layouts/Base.astro";
import atlas from "../../data/atlas.json";

export function getStaticPaths() {
  return Object.values(atlas.practices || {}).map((p) => ({
    params: { practice: p.key },
    props: { practice: p },
  }));
}

const { practice } = Astro.props;
---

<Base
  title={practice.label}
  description={`Companies tagged ${practice.label} — compare theses side by side.`}
>
  <article class="prose">
    <p class="section-label">Practice</p>
    <h1>{practice.label}</h1>
    <p class="lede">
      {practice.companies?.length || 0} companies · {practice.episodes?.length || 0}{" "}
      cards ·
      <a href={`/compare`}>Open compare</a>
    </p>

    <h2>Companies</h2>
    {
      practice.companies?.length ? (
        <ul class="episode-list">
          {practice.companies.map((c) => (
            <li>
              <a href={`/companies/${c.slug}`}>
                <div class="meta">{c.name}</div>
                <h3>{c.thesis || c.name}</h3>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No companies tagged yet.</p>
      )
    }

    <h2>Cards</h2>
    {
      practice.episodes?.length ? (
        <ul class="episode-list">
          {practice.episodes.map((e) => (
            <li>
              <a href={`/episodes/${e.slug}`}>
                <div class="meta">{e.company || "—"}</div>
                <h3>{e.thesis || e.company || "Untitled card"}</h3>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No cards tagged yet.</p>
      )
    }
  </article>
</Base>
