---
import Base from "../layouts/Base.astro";
import companies from "../data/companies.json";
import tensions from "../data/tensions.json";
import themesData from "../data/tension-themes.json";
import { stealBullets } from "../lib/format.mjs";

const bySlug = Object.fromEntries(companies.map((c) => [c.slug, c]));

const heresyMeta = [
  { slug: "tinybird", label: "Deleted the PM layer" },
  { slug: "hellotickets", label: "Product engineering owns strategy" },
  { slug: "ontrack", label: "Telegram MVP before process" },
  { slug: "dcycle", label: "Skip CEO and sales gates" },
  { slug: "real-madrid", label: "Never monetize socios" },
  { slug: "ikualo", label: "Bank the rejected" },
  { slug: "getinvoice", label: "Solo founder, no product org" },
  { slug: "eva", label: "Public-health chat in days" },
  { slug: "trucksters", label: "PM as P&L owner" },
  { slug: "piper", label: "Forecast from conversation data" },
];
const heresyBySlug = Object.fromEntries(heresyMeta.map((h) => [h.slug, h.label]));

const rows = tensions
  .map((t) => {
    const a = bySlug[t.a.slug];
    const b = bySlug[t.b.slug];
    if (!a || !b) return null;
    return {
      ...t,
      aOrg: a,
      bOrg: b,
      aOwn: stealBullets(a.episodes?.[0]?.ownership, 1),
      bOwn: stealBullets(b.episodes?.[0]?.ownership, 1),
      aHeresy: heresyBySlug[t.a.slug] || null,
      bHeresy: heresyBySlug[t.b.slug] || null,
    };
  })
  .filter(Boolean);

const themeById = {};
for (const theme of themesData.themes || []) {
  for (const id of theme.ids) {
    if (!themeById[id]) themeById[id] = [];
    themeById[id].push(theme.id);
  }
}

const heresies = heresyMeta
  .map((h) => {
    const c = bySlug[h.slug];
    return c ? { ...h, org: c } : null;
  })
  .filter(Boolean);

const themesPayload = JSON.stringify(
  (themesData.themes || []).map((t) => ({ id: t.id, label: t.label })),
);
---

<Base
  title="Tensions"
  description="Paired operating bets that disagree — the atlas as argument, not catalog."
>
  <section class="tensions-hero">
    <p class="section-label">Contrast mode</p>
    <h1>Tensions</h1>
    <p class="lede">
      {rows.length} opposing bets. Each row is one operating question with
      opposite answers — read both poles in twenty seconds, then steal the bet
      that fits.
    </p>
    <p class="hero-actions">
      <a class="hero-cta" href="/steal?go=1">Steal a random bet →</a>
      <a class="text-link" href="/pole">Which pole are you?</a>
      <a class="text-link" href="/compare">Compare</a>
    </p>
  </section>

  {
    heresies.length ? (
      <section class="heresy-strip">
        <p class="section-label">Heresies</p>
        <p class="heresy-strip__hint">
          Rare bets that break the default product-org script.
        </p>
        <div class="heresy-strip__row">
          {heresies.map((h) => (
            <a class="heresy-chip" href={`/companies/${h.slug}`}>
              <span class="heresy-chip__label">{h.label}</span>
              <strong>{h.org.name}</strong>
            </a>
          ))}
        </div>
      </section>
    ) : null
  }

  <div class="tension-filters" id="tension-filters" data-themes={themesPayload}>
    <p class="section-label">Browse by lens</p>
    <div class="tension-filters__row" role="tablist" aria-label="Tension themes">
      <button
        type="button"
        class="filter-chip is-active"
        data-theme="all"
        aria-pressed="true">All ({rows.length})</button
      >
      {
        (themesData.themes || []).map((theme) => (
          <button
            type="button"
            class="filter-chip"
            data-theme={theme.id}
            aria-pressed="false"
          >
            {theme.label}
            <span class="filter-chip__count">{theme.ids.length}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="tension-list" id="tension-list">
    {
      rows.map((t, i) => (
        <article
          class="tension"
          id={t.id}
          style={`--i: ${i}`}
          data-themes={(themeById[t.id] || []).join(" ")}
        >
          <header class="tension__axis">
            <span class="tension__index">{String(i + 1).padStart(2, "0")}</span>
            <h2>
              <a href={`/tensions/${t.id}`}>{t.axis}</a>
            </h2>
          </header>
          <div class="tension__duel">
            <a class="tension__pole" href={`/companies/${t.a.slug}`}>
              <p class="tension__pole-label">{t.a.pole}</p>
              <h3>{t.aOrg.name}</h3>
              {
                t.aHeresy ? (
                  <span class="tension__heresy">{t.aHeresy}</span>
                ) : null
              }
              <p class="tension__thesis">{t.aOrg.thesis}</p>
              {
                t.aOwn.length ? (
                  <ul class="tension__own">
                    {t.aOwn.map((row) =>
                      row.label ? (
                        <li>
                          <strong>{row.label}</strong> {row.text}
                        </li>
                      ) : (
                        <li>{row.text}</li>
                      )
                    )}
                  </ul>
                ) : null
              }
              <span class="tension__stage">{t.aOrg.stage || "—"}</span>
            </a>
            <div class="tension__vs" aria-hidden="true">
              <span>vs</span>
            </div>
            <a class="tension__pole tension__pole--b" href={`/companies/${t.b.slug}`}>
              <p class="tension__pole-label">{t.b.pole}</p>
              <h3>{t.bOrg.name}</h3>
              {
                t.bHeresy ? (
                  <span class="tension__heresy">{t.bHeresy}</span>
                ) : null
              }
              <p class="tension__thesis">{t.bOrg.thesis}</p>
              {
                t.bOwn.length ? (
                  <ul class="tension__own">
                    {t.bOwn.map((row) =>
                      row.label ? (
                        <li>
                          <strong>{row.label}</strong> {row.text}
                        </li>
                      ) : (
                        <li>{row.text}</li>
                      )
                    )}
                  </ul>
                ) : null
              }
              <span class="tension__stage">{t.bOrg.stage || "—"}</span>
            </a>
          </div>
          <p class="tension__note">{t.note}</p>
          <p class="tension__actions hero-actions">
            <a class="hero-cta" href={`/tensions/${t.id}`}>
              Steal this bet →
            </a>
            <a
              class="text-link"
              href={`/compare?a=${t.a.slug}&b=${t.b.slug}`}
            >
              Compare
            </a>
            <a class="text-link" href={`/desk?a=${t.a.slug}&b=${t.b.slug}`}>
              Desk
            </a>
          </p>
        </article>
      ))
    }
  </div>

  <p class="tension-empty" id="tension-empty" hidden>
    No tensions in this lens.
  </p>

  <p class="tensions-foot">
    Not sure where you stand?{" "}
    <a href="/pole">Which pole are you?</a>
    ·
    <a href="/steal">Steal a bet</a>
    ·
    <a href="/compare">Build your own compare</a>
    ·
    <a href="/">Back to the map</a>
  </p>
</Base>

<script>
  const filters = document.getElementById("tension-filters");
  const list = document.getElementById("tension-list");
  const empty = document.getElementById("tension-empty");
  if (filters && list) {
    const chips = [...filters.querySelectorAll("[data-theme]")];
    const rows = [...list.querySelectorAll(".tension")];

    function apply(theme) {
      let shown = 0;
      for (const row of rows) {
        const themes = (row.dataset.themes || "").split(/\s+/).filter(Boolean);
        const match = theme === "all" || themes.includes(theme);
        row.hidden = !match;
        if (match) shown += 1;
      }
      for (const chip of chips) {
        const on = chip.dataset.theme === theme;
        chip.classList.toggle("is-active", on);
        chip.setAttribute("aria-pressed", on ? "true" : "false");
      }
      if (empty) empty.hidden = shown > 0;
      const url = new URL(window.location.href);
      if (theme === "all") url.searchParams.delete("theme");
      else url.searchParams.set("theme", theme);
      history.replaceState({}, "", url);
    }

    filters.addEventListener("click", (e) => {
      const btn = e.target.closest("[data-theme]");
      if (!btn) return;
      apply(btn.dataset.theme);
    });

    const initial = new URLSearchParams(window.location.search).get("theme");
    if (initial && chips.some((c) => c.dataset.theme === initial)) apply(initial);
  }
</script>
