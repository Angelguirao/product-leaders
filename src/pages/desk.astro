---
import Base from "../layouts/Base.astro";
import companies from "../data/companies.json";
import tensions from "../data/tensions.json";
import { craftFor, craftShort } from "../lib/craft.mjs";

const bySlug = Object.fromEntries(companies.map((c) => [c.slug, c]));

const options = companies
  .map((c) => {
    const primary = c.episodes?.[0];
    const craft = craftFor(c.slug);
    return {
      slug: c.slug,
      name: c.name,
      stage: c.stage || "other",
      thesis: c.thesis || "",
      ownership: (primary?.ownership || []).slice(0, 4),
      loop: (primary?.loop_bullets || []).slice(0, 4),
      craft: craft
        ? { lean: craft.lean, short: craftShort(craft.lean), note: craft.note }
        : null,
      guest: primary?.guest || "",
      role: primary?.role || "",
    };
  })
  .sort((a, b) => a.name.localeCompare(b.name));

const presets = tensions
  .filter((t) => bySlug[t.a.slug] && bySlug[t.b.slug])
  .slice(-8)
  .reverse()
  .map((t) => ({
    label: t.axis,
    a: t.a.slug,
    b: t.b.slug,
    id: t.id,
  }));

const tensionIndex = tensions
  .filter((t) => bySlug[t.a.slug] && bySlug[t.b.slug])
  .map((t) => ({
    id: t.id,
    axis: t.axis,
    note: t.note,
    a: t.a.slug,
    b: t.b.slug,
    aPole: t.a.pole,
    bPole: t.b.pole,
  }));

const payload = JSON.stringify({ orgs: options, tensions: tensionIndex });
---

<Base
  title="Desk cards"
  description="Print 1–3 product-org cards for a strategy debate — thesis, ownership, and craft lean on one sheet."
>
  <section class="desk-hero no-print">
    <p class="section-label">Print mode</p>
    <h1>Desk cards</h1>
    <p class="lede">
      Pick one to three orgs. Print them. Put the opposing bets on the table
      before you copy a framework.
    </p>
  </section>

  <div class="desk-presets no-print" id="desk-presets">
    <p class="section-label">From a tension</p>
    <div class="compare-presets__row">
      {
        presets.map((p) => (
          <a
            class="peer-chip"
            href={`/desk?a=${p.a}&b=${p.b}`}
            data-a={p.a}
            data-b={p.b}
          >
            {p.label}
          </a>
        ))
      }
    </div>
  </div>

  <div class="desk-root" id="desk-root" data-payload={payload}>
    <div class="desk-picker no-print compare-selects">
      <label>
        Card A
        <select id="desk-a"></select>
      </label>
      <label>
        Card B
        <select id="desk-b">
          <option value="">—</option>
        </select>
      </label>
      <label>
        Card C <span class="optional">(optional)</span>
        <select id="desk-c">
          <option value="">—</option>
        </select>
      </label>
      <div class="desk-picker__actions">
        <button type="button" class="filter-reset" id="desk-print">
          Print
        </button>
        <button type="button" class="text-link" id="desk-copy">
          Copy link
        </button>
        <a class="text-link" href="/tensions">Browse tensions</a>
      </div>
    </div>

    <div class="desk-sheet" id="desk-sheet" aria-live="polite"></div>
  </div>
</Base>

<script>
  const root = document.getElementById("desk-root");
  if (!root) throw new Error("desk root missing");
  const data = JSON.parse(root.dataset.payload || "{}");
  /** @type {any[]} */
  const orgs = data.orgs || [];
  /** @type {any[]} */
  const tensionList = data.tensions || [];
  const bySlug = Object.fromEntries(orgs.map((o) => [o.slug, o]));

  const selA = /** @type {HTMLSelectElement} */ (document.getElementById("desk-a"));
  const selB = /** @type {HTMLSelectElement} */ (document.getElementById("desk-b"));
  const selC = /** @type {HTMLSelectElement} */ (document.getElementById("desk-c"));
  const sheet = document.getElementById("desk-sheet");

  function fillSelect(sel, includeEmpty) {
    const keep = sel.value;
    sel.innerHTML = includeEmpty ? `<option value="">—</option>` : "";
    for (const o of orgs) {
      const opt = document.createElement("option");
      opt.value = o.slug;
      opt.textContent = o.name;
      sel.appendChild(opt);
    }
    if (keep && bySlug[keep]) sel.value = keep;
  }

  fillSelect(selA, false);
  fillSelect(selB, true);
  fillSelect(selC, true);

  const params = new URLSearchParams(window.location.search);
  if (params.get("a") && bySlug[params.get("a")]) selA.value = params.get("a");
  else if (orgs[0]) selA.value = orgs[0].slug;
  if (params.get("b") && bySlug[params.get("b")]) selB.value = params.get("b");
  if (params.get("c") && bySlug[params.get("c")]) selC.value = params.get("c");

  function escapeHtml(s) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function findTension(aSlug, bSlug) {
    if (!aSlug || !bSlug) return null;
    return tensionList.find(
      (t) =>
        (t.a === aSlug && t.b === bSlug) || (t.a === bSlug && t.b === aSlug)
    );
  }

  function cardHtml(o, pole) {
    const ownership = (o.ownership || [])
      .map((b) => `<li>${escapeHtml(b)}</li>`)
      .join("");
    const loop = (o.loop || [])
      .map((b) => `<li>${escapeHtml(b)}</li>`)
      .join("");
    return `
      <article class="desk-card">
        ${pole ? `<p class="desk-card__pole">${escapeHtml(pole)}</p>` : ""}
        <p class="desk-card__meta">${escapeHtml(o.stage)}${
          o.guest ? ` · ${escapeHtml(o.guest)}` : ""
        }</p>
        <h2>${escapeHtml(o.name)}</h2>
        ${
          o.craft
            ? `<span class="craft-pill craft-pill--${escapeHtml(o.craft.lean)}">${escapeHtml(o.craft.short)}</span>`
            : `<span class="desk-card__unset">Craft lean unset</span>`
        }
        <p class="desk-card__thesis">${escapeHtml(o.thesis)}</p>
        ${
          ownership
            ? `<p class="desk-card__label">Ownership</p><ul>${ownership}</ul>`
            : ""
        }
        ${loop ? `<p class="desk-card__label">Loop</p><ul>${loop}</ul>` : ""}
        <p class="desk-card__foot">product-leaders · /companies/${escapeHtml(o.slug)}</p>
      </article>
    `;
  }

  function syncUrl() {
    const u = new URL(window.location.href);
    u.searchParams.set("a", selA.value);
    if (selB.value) u.searchParams.set("b", selB.value);
    else u.searchParams.delete("b");
    if (selC.value) u.searchParams.set("c", selC.value);
    else u.searchParams.delete("c");
    history.replaceState({}, "", u.pathname + u.search);
  }

  function render() {
    const slugs = [selA.value, selB.value, selC.value].filter(Boolean);
    const unique = [...new Set(slugs)];
    const cards = unique.map((s) => bySlug[s]).filter(Boolean);
    if (!sheet) return;
    if (!cards.length) {
      sheet.innerHTML = `<p class="empty">Pick at least one org.</p>`;
      return;
    }

    const t = findTension(selA.value, selB.value);
    let header = "";
    let poleBySlug = {};
    if (t && !selC.value) {
      poleBySlug[t.a] = t.aPole;
      poleBySlug[t.b] = t.bPole;
      header = `
        <header class="desk-axis">
          <p class="section-label">Tension</p>
          <h2>${escapeHtml(t.axis)}</h2>
          <p>${escapeHtml(t.note)}</p>
          <p class="desk-axis__steal">
            Steal from <strong>${escapeHtml(bySlug[t.a]?.name || t.a)}</strong>
            (“${escapeHtml(t.aPole)}”), then argue with
            <strong>${escapeHtml(bySlug[t.b]?.name || t.b)}</strong>.
          </p>
        </header>
      `;
    }

    sheet.innerHTML = `${header}<div class="desk-grid desk-grid--${cards.length}">${cards
      .map((c) => cardHtml(c, poleBySlug[c.slug]))
      .join("")}</div>`;
    syncUrl();
  }

  [selA, selB, selC].forEach((sel) => sel.addEventListener("change", render));
  document.getElementById("desk-print")?.addEventListener("click", () => window.print());
  document.getElementById("desk-copy")?.addEventListener("click", async (e) => {
    const btn = /** @type {HTMLElement} */ (e.currentTarget);
    try {
      await navigator.clipboard.writeText(window.location.href);
      btn.textContent = "Copied";
      setTimeout(() => {
        btn.textContent = "Copy link";
      }, 1600);
    } catch {
      btn.textContent = "Copy failed";
    }
  });

  document.getElementById("desk-presets")?.addEventListener("click", (e) => {
    const a = e.target.closest("[data-a]");
    if (!a) return;
    e.preventDefault();
    selA.value = a.dataset.a || "";
    selB.value = a.dataset.b || "";
    selC.value = "";
    render();
  });

  render();
</script>
