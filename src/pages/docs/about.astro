---
import Base from "../../layouts/Base.astro";
import atlas from "../../data/atlas.json";
import tensions from "../../data/tensions.json";
import craft from "../../data/craft-lean.json";
import companies from "../../data/companies.json";

const craftTagged = Object.keys(craft.leans || {}).length;
const tensionCount = tensions.length;
const inTension = new Set();
for (const t of tensions) {
  inTension.add(t.a.slug);
  inTension.add(t.b.slug);
}
---

<Base
  title="About this atlas"
  description="What Product Leaders Atlas is, how to share it, and how cards are made."
>
  <article class="prose">
    <h1>About this atlas</h1>
    <p class="lede">
      A public English map of how product orgs actually operate — and how they
      disagree. One sharp thesis per company; compare ownership, craft, and
      stage.
    </p>

    <h2>Why it exists</h2>
    <p>
      Most interview notes die in notebooks. This project turns Product Leaders
      conversations into sparse company cards you can scan in twenty seconds and
      stack against peers. The goal is contrast, not coverage theater.
    </p>

    <h2>What’s on the map</h2>
    <ul>
      <li>
        <strong>{atlas.company_count}</strong> published orgs on the
        <a href="/">map</a>
      </li>
      <li>
        <strong>{tensionCount}</strong> curated tensions covering{" "}
        <strong>{inTension.size}</strong> of those orgs — start on{" "}
        <a href="/tensions">/tensions</a> or{" "}
        <a href="/steal">steal a random bet</a>
      </li>
      <li>
        <strong>{craftTagged}</strong> of {companies.length} orgs carry a craft
        lean (eng / PM / design / founder). The rest stay unset on purpose —
        see <a href="/gaps#craft">/gaps</a>
      </li>
      <li>
        <strong>{atlas.weak_count || 0}</strong> held as weak (soft thesis,
        theory, or unstable org signal)
      </li>
      <li>
        Compare any two or three on <a href="/compare">/compare</a>
      </li>
      <li>
        Five forced choices on <a href="/pole">/pole</a> — land on a tension
        that fits how you already operate
      </li>
      <li>
        Print opposing bets as <a href="/desk">desk cards</a>
      </li>
    </ul>

    <h2>Share</h2>
    <p>
      Link a tension, a steal draw (<code>/steal?go=1</code>), a pole result
      (<code>/pole?tension=…&amp;side=a</code>), a filtered map, a company
      card, or a compare URL. Cards are original English synthesis — not
      transcripts. Source episode titles stay in Spanish as muted labels.
    </p>
    <p class="share-blurb">
      Product Leaders Atlas — see how product orgs disagree, then steal the bet
      that fits.
    </p>
    <ul>
      <li>
        Map: <a href="https://product-leaders-self.vercel.app/"
          >product-leaders-self.vercel.app</a
        >
      </li>
      <li>
        Surprise:{" "}
        <a href="https://product-leaders-self.vercel.app/steal?go=1"
          >Steal a random bet</a
        >
        {" "}
        · lens example:{" "}
        <a href="https://product-leaders-self.vercel.app/steal?theme=craft&amp;go=1"
          >craft only</a
        >
      </li>
      <li>
        Sample compare:{" "}
        <a
          href="https://product-leaders-self.vercel.app/compare?a=cabify&amp;b=shakers&amp;c=webel"
          >Cabify vs Shakers vs Webel</a
        >
      </li>
      <li>
        Repo:
        <a href="https://github.com/Angelguirao/product-leaders"
          >github.com/Angelguirao/product-leaders</a
        >
      </li>
    </ul>

    <h2>How cards are made</h2>
    <p>
      Catalog → extract → LLM brief → quality gate → index. Only
      <strong>published</strong> cards appear on the map. Read
      <a href="/docs/how-to-read">how to read a card</a> and
      <a href="/docs/legal">legal notes</a>.
    </p>

    <h2>Source</h2>
    <p>
      Seeded from Dani Diestre’s
      <a href="https://podcasters.spotify.com/pod/show/danidiestre"
        >Entrevistas a Product Leaders</a
      >. Unofficial. Not affiliated.
    </p>
  </article>
</Base>
