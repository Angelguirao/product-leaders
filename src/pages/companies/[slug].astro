---
import Base from "../../layouts/Base.astro";
import companies from "../../data/companies.json";
import tensions from "../../data/tensions.json";
import Mermaid from "../../components/Mermaid.astro";
import ShareRow from "../../components/ShareRow.astro";
import { craftFor, craftShort } from "../../lib/craft.mjs";
import { parseOwnershipLine, practiceShort } from "../../lib/format.mjs";

export function getStaticPaths() {
  return companies.map((c) => ({
    params: { slug: c.slug },
    props: { company: c },
  }));
}

const { company } = Astro.props;
const primary = company.episodes?.[0];
const thesis = company.thesis || primary?.thesis || "";
const craft = craftFor(company.slug);
const bySlug = Object.fromEntries(companies.map((c) => [c.slug, c]));

const relatedTensions = tensions
  .filter((t) => t.a.slug === company.slug || t.b.slug === company.slug)
  .map((t) => {
    const selfIsA = t.a.slug === company.slug;
    const otherSlug = selfIsA ? t.b.slug : t.a.slug;
    const other = bySlug[otherSlug];
    const selfPole = selfIsA ? t.a.pole : t.b.pole;
    const otherPole = selfIsA ? t.b.pole : t.a.pole;
    return other
      ? {
          id: t.id,
          axis: t.axis,
          selfPole,
          otherPole,
          other,
          you: selfIsA ? "a" : "b",
        }
      : null;
  })
  .filter(Boolean);

const opponentSlugs = new Set(relatedTensions.map((t) => t.other.slug));

function peerScore(a, b) {
  let score = 0;
  if (opponentSlugs.has(b.slug)) score += 12;
  const aLean = craftFor(a.slug)?.lean;
  const bLean = craftFor(b.slug)?.lean;
  if (aLean && aLean === bLean) score += 4;
  const ap = new Set(a.practices || []);
  const shared = (b.practices || []).filter((p) => ap.has(p)).length;
  const sameStage = (a.stage || "") === (b.stage || "") ? 1 : 0;
  return score + shared * 2 + sameStage;
}

const peers = companies
  .filter((c) => c.slug !== company.slug)
  .map((c) => ({ c, score: peerScore(company, c) }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || a.c.name.localeCompare(b.c.name))
  .slice(0, 4)
  .map((x) => x.c);

const compareHref =
  relatedTensions.length >= 1
    ? `/compare?a=${company.slug}&b=${relatedTensions[0].other.slug}${
        relatedTensions[1] ? `&c=${relatedTensions[1].other.slug}` : ""
      }`
    : peers.length >= 1
      ? `/compare?a=${company.slug}&b=${peers[0].slug}${peers[1] ? `&c=${peers[1].slug}` : ""}`
      : `/compare?a=${company.slug}`;
---

<Base
  title={company.name}
  description={thesis || `How ${company.name} runs product.`}
  ogImage={`/og/${company.slug}.png`}
>
  <article class="company-os">
    <header class="company-os__head">
      <p class="section-label">Product org</p>
      <h1>{company.name}</h1>
      <p class="company-os__thesis">{thesis}</p>
      <p class="lede">
        {company.stage || "stage unknown"}
        {
          primary?.guest
            ? ` · ${primary.guest}${primary.role ? `, ${primary.role}` : ""}`
            : ""
        }
      </p>
      {
        craft ? (
          <div class="craft-callout">
            <span class={`craft-pill craft-pill--${craft.lean}`}>
              {craftShort(craft.lean)}
            </span>
            <p>{craft.note}</p>
            <p class="craft-callout__hint">
              Craft lean is curated from ownership signals — see{" "}
              <a href="/tensions/product-engineering-vs-pm"
                >product engineering vs PM craft</a
              >.
            </p>
          </div>
        ) : (
          <p class="craft-unset">
            No strong craft lean tagged yet — the interview doesn’t clearly land
            eng vs PM vs design ownership. See{" "}
            <a href="/gaps#craft">all unset craft leans</a>.
          </p>
        )
      }
      {
        company.practices?.length ? (
          <div class="tags" style="margin-top: 1rem;">
            {company.practices.map((p) => (
              <a class="tag" href={`/practices/${p}`} title={p}>
                {practiceShort(p)}
              </a>
            ))}
          </div>
        ) : null
      }
      <p class="company-os__actions hero-actions">
        {
          relatedTensions.length ? (
            <a
              class="hero-cta"
              href={`/tensions/${relatedTensions[0].id}?you=${relatedTensions[0].you}`}
            >
              Steal this bet →
            </a>
          ) : (
            <a class="hero-cta" href="/steal?go=1">Steal a bet →</a>
          )
        }
        <a class="text-link" href={compareHref}>Compare with peers</a>
        <a class="text-link" href={`/desk?a=${company.slug}`}>
          Print desk card
        </a>
        {
          relatedTensions.length > 1 ? (
            <a class="text-link" href={`#argues`}>
              In {relatedTensions.length} tensions
            </a>
          ) : !relatedTensions.length ? (
            <a class="text-link" href="/gaps#thin">
              Thin coverage
            </a>
          ) : null
        }
        <ShareRow text={`${company.name}: ${thesis}`} copyId="copy-page-link" />
        <a class="text-link" href="/docs/how-to-read">How to read</a>
      </p>
    </header>

    {
      relatedTensions.length ? (
        <section class="company-tensions" id="argues">
          <p class="section-label">Argues with</p>
          <ul class="company-tensions__list">
            {relatedTensions.map((t) => (
              <li>
                <a href={`/tensions/${t.id}?you=${t.you}`}>{t.axis}</a>
                <span class="company-tensions__vs">
                  {t.selfPole} vs {t.otherPole}
                </span>
                —{" "}
                <a href={`/companies/${t.other.slug}`}>{t.other.name}</a>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

      {
        peers.length ? (
          <section class="peer-strip">
            <p class="section-label">
              {opponentSlugs.size
                ? "Opponents & nearby"
                : "Nearby on the map"}
            </p>
            <div class="peer-strip__row">
              {peers.map((p) => (
                <a class="peer-chip" href={`/companies/${p.slug}`}>
                  <strong>{p.name}</strong>
                  <span>
                    {opponentSlugs.has(p.slug) ? "Argues with you · " : ""}
                    {p.thesis}
                  </span>
                </a>
              ))}
            </div>
          </section>
        ) : null
      }

    {
      company.episodes.map((e, i) => (
        <section class="company-os__block">
          {company.episodes.length > 1 ? (
            <header class="company-os__ep-head">
              <p class="section-label">
                Interview {i + 1} of {company.episodes.length}
                {e.guest
                  ? ` · ${e.guest}${e.role ? `, ${e.role}` : ""}`
                  : ""}
              </p>
              {e.thesis && e.thesis !== thesis ? (
                <p class="company-os__ep-thesis">{e.thesis}</p>
              ) : null}
            </header>
          ) : null}
          {e.context ? <p class="company-os__snapshot">{e.context}</p> : null}

          <h2>Operating loop</h2>
          {
            e.loop_mermaid ? (
              <details class="loop-details">
                <summary>Show operating loop diagram</summary>
                <Mermaid code={e.loop_mermaid} />
              </details>
            ) : null
          }
          {!e.loop_mermaid && e.loop_bullets?.length ? (
            <ul>
              {e.loop_bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          ) : null}
          {e.loop_mermaid && e.loop_bullets?.length ? (
            <ul class="loop-bullets-aside">
              {e.loop_bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          ) : null}
          {!e.loop_mermaid && !e.loop_bullets?.length ? (
            <p class="empty">No operating loop captured yet.</p>
          ) : null}

          {e.ownership?.length ? (
            <>
              <h2>Ownership</h2>
              <ul class="ownership-list">
                {e.ownership.map((b) => {
                  const { label, text } = parseOwnershipLine(b);
                  return label ? (
                    <li>
                      <strong>{label}</strong> {text}
                    </li>
                  ) : (
                    <li>{text}</li>
                  );
                })}
              </ul>
            </>
          ) : null}

          {e.evidence?.length ? (
            <>
              <h2>Evidence</h2>
              <ul>
                {e.evidence.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </>
          ) : null}

          {e.gaps?.length ? (
            <>
              <h2>Gaps</h2>
              <ul>
                {e.gaps.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </>
          ) : null}

          <p class="company-os__source">
            {e.url ? (
              <a href={e.url} rel="noopener">
                Watch interview
              </a>
            ) : null}
            {e.url ? " · " : null}
            <a href={`/episodes/${e.slug}`}>Full card</a>
          </p>
        </section>
      ))
    }
  </article>
</Base>
