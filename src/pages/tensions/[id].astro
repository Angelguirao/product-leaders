---
import Base from "../../layouts/Base.astro";
import companies from "../../data/companies.json";
import tensions from "../../data/tensions.json";
import themesData from "../../data/tension-themes.json";
import { craftFor, craftShort } from "../../lib/craft.mjs";

export function getStaticPaths() {
  const bySlug = Object.fromEntries(companies.map((c) => [c.slug, c]));
  return tensions
    .filter((t) => bySlug[t.a.slug] && bySlug[t.b.slug])
    .map((t) => ({ params: { id: t.id } }));
}

const bySlug = Object.fromEntries(companies.map((c) => [c.slug, c]));
const { id } = Astro.params;
const tension = tensions.find((t) => t.id === id);
if (!tension) {
  throw new Error(`Unknown tension: ${id}`);
}

const aOrg = bySlug[tension.a.slug];
const bOrg = bySlug[tension.b.slug];
if (!aOrg || !bOrg) {
  throw new Error(`Missing orgs for tension: ${id}`);
}

const aCraft = craftFor(tension.a.slug);
const bCraft = craftFor(tension.b.slug);
const ogImage = `/og/tensions/${tension.id}.png`;
const description = `${tension.a.pole} (${aOrg.name}) vs ${tension.b.pole} (${bOrg.name}). ${tension.note}`;

const themeHits = (themesData.themes || []).filter((th) =>
  th.ids.includes(tension.id),
);
const relatedThemeIds = new Set(themeHits.flatMap((th) => th.ids));
relatedThemeIds.delete(tension.id);

const relatedTensions = [...relatedThemeIds]
  .map((rid) => {
    const t = tensions.find((x) => x.id === rid);
    if (!t) return null;
    const a = bySlug[t.a.slug];
    const b = bySlug[t.b.slug];
    if (!a || !b) return null;
    return { ...t, aOrg: a, bOrg: b };
  })
  .filter(Boolean)
  .slice(0, 4);
---

<Base title={tension.axis} description={description} ogImage={ogImage}>
  <article class="tension tension--solo">
    <p class="section-label">
      <a href="/tensions">Tensions</a>
      {
        themeHits.length ? (
          <>
            {" · "}
            {themeHits.map((th, i) => (
              <>
                {i > 0 ? " · " : null}
                <a href={`/tensions?theme=${th.id}`}>{th.label}</a>
              </>
            ))}
          </>
        ) : null
      }
    </p>
    <header class="tension__axis">
      <h1>{tension.axis}</h1>
    </header>
    <p class="lede tension-solo__lede">{tension.note}</p>

    <div class="tension__duel" id="tension-duel">
      <a class="tension__pole" data-side="a" href={`/companies/${tension.a.slug}`}>
        <p class="tension__pole-label" data-pole-label="a">{tension.a.pole}</p>
        <h2>{aOrg.name}</h2>
        {
          aCraft ? (
            <span class={`craft-pill craft-pill--${aCraft.lean}`}>
              {craftShort(aCraft.lean)}
            </span>
          ) : null
        }
        <p class="tension__thesis">{aOrg.thesis}</p>
        <span class="tension__stage">{aOrg.stage || "—"}</span>
      </a>
      <div class="tension__vs" aria-hidden="true">
        <span>vs</span>
      </div>
      <a class="tension__pole tension__pole--b" data-side="b" href={`/companies/${tension.b.slug}`}>
        <p class="tension__pole-label" data-pole-label="b">{tension.b.pole}</p>
        <h2>{bOrg.name}</h2>
        {
          bCraft ? (
            <span class={`craft-pill craft-pill--${bCraft.lean}`}>
              {craftShort(bCraft.lean)}
            </span>
          ) : null
        }
        <p class="tension__thesis">{bOrg.thesis}</p>
        <span class="tension__stage">{bOrg.stage || "—"}</span>
      </a>
    </div>

    <p class="tension-you-banner" id="tension-you-banner" hidden></p>

    <p class="tension__actions hero-actions">
      <a
        class="text-link"
        href={`/compare?a=${tension.a.slug}&b=${tension.b.slug}`}
      >
        Open in compare →
      </a>
      <a
        class="text-link"
        href={`/desk?a=${tension.a.slug}&b=${tension.b.slug}`}
      >
        Print desk cards
      </a>
      <a class="text-link" href="/pole">Take the pole quiz</a>
      <a class="text-link" id="steal-again" href="/steal?go=1">Steal another bet</a>
      <button type="button" class="text-link" id="tension-copy">
        Copy link
      </button>
    </p>
  </article>

  {
    relatedTensions.length ? (
      <section class="related-tensions">
        <p class="section-label">More in this lens</p>
        <div class="related-tensions__row">
          {relatedTensions.map((t) => (
            <a class="related-tension-chip" href={`/tensions/${t.id}`}>
              <span class="related-tension-chip__axis">{t.axis}</span>
              <span class="related-tension-chip__pair">
                {t.aOrg.name} vs {t.bOrg.name}
              </span>
            </a>
          ))}
        </div>
      </section>
    ) : null
  }

  <p class="tensions-foot">
    <a href="/tensions">All tensions</a>
    ·
    <a href="/pole">Which pole are you?</a>
    ·
    <a href="/steal">Steal a bet</a>
    ·
    <a href="/">Map</a>
  </p>
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const you = params.get("you");
  const theme = params.get("theme");
  const fromSteal = params.get("from") === "steal";

  if (you === "a" || you === "b") {
    document.querySelectorAll("#tension-duel [data-side]").forEach((el) => {
      const on = el.getAttribute("data-side") === you;
      el.classList.toggle("pole-result__you", on);
      const label = el.querySelector("[data-pole-label]");
      if (on && label && !label.textContent?.startsWith("Your pole")) {
        label.textContent = `Your pole · ${label.textContent}`;
      }
    });
    const banner = document.getElementById("tension-you-banner");
    if (banner) {
      banner.hidden = false;
      banner.textContent =
        "From the pole quiz — the highlighted side is your lean. Argue with the other before you copy.";
    }
  }

  const stealAgain = document.getElementById("steal-again");
  if (stealAgain) {
    const stealUrl = new URL("/steal", window.location.origin);
    stealUrl.searchParams.set("go", "1");
    if (theme) stealUrl.searchParams.set("theme", theme);
    stealAgain.setAttribute("href", stealUrl.pathname + stealUrl.search);
    if (fromSteal || theme) {
      stealAgain.textContent = theme
        ? "Draw another in this lens"
        : "Draw another bet";
    }
  }

  document.getElementById("tension-copy")?.addEventListener("click", async (e) => {
    const btn = /** @type {HTMLElement} */ (e.currentTarget);
    try {
      await navigator.clipboard.writeText(window.location.href);
      btn.textContent = "Copied";
      setTimeout(() => {
        btn.textContent = "Copy link";
      }, 1600);
    } catch {
      btn.textContent = "Copy failed";
    }
  });
</script>
