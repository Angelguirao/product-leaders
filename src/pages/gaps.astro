---
import Base from "../layouts/Base.astro";
import atlas from "../data/atlas.json";
import companies from "../data/companies.json";
import episodes from "../data/episodes.json";
import tensions from "../data/tensions.json";
import gaps from "../data/gaps.json";
import { craftFor } from "../lib/craft.mjs";

const bySlug = Object.fromEntries(companies.map((c) => [c.slug, c]));
const epBySlug = Object.fromEntries(episodes.map((e) => [e.slug, e]));

const bucketLabels = {
  theory: "Theory / playbook",
  festival: "Festival / roundup",
  education: "Education business",
  soft: "Soft thesis",
  unstable: "Unstable org signal",
};

const held = (gaps.held || [])
  .map((h) => {
    const e = epBySlug[h.slug];
    if (!e) return null;
    return {
      ...h,
      episode: e,
      title: e.company || e.guest || e.title || h.slug,
      thesis: e.thesis || "",
      bucketLabel: bucketLabels[h.bucket] || h.bucket,
    };
  })
  .filter(Boolean);

const heldByBucket = {};
for (const h of held) {
  if (!heldByBucket[h.bucket]) heldByBucket[h.bucket] = [];
  heldByBucket[h.bucket].push(h);
}

const unsetCraft = companies
  .filter((c) => !craftFor(c.slug))
  .sort((a, b) => a.name.localeCompare(b.name));

const tensionCountBySlug = {};
for (const t of tensions) {
  tensionCountBySlug[t.a.slug] = (tensionCountBySlug[t.a.slug] || 0) + 1;
  tensionCountBySlug[t.b.slug] = (tensionCountBySlug[t.b.slug] || 0) + 1;
}

const singleTension = companies
  .filter((c) => (tensionCountBySlug[c.slug] || 0) === 1)
  .map((c) => {
    const t = tensions.find(
      (x) => x.a.slug === c.slug || x.b.slug === c.slug
    );
    if (!t) return null;
    const selfIsA = t.a.slug === c.slug;
    const otherSlug = selfIsA ? t.b.slug : t.a.slug;
    const other = bySlug[otherSlug];
    return other
      ? {
          org: c,
          tension: t,
          other,
          you: selfIsA ? "a" : "b",
          selfPole: selfIsA ? t.a.pole : t.b.pole,
          otherPole: selfIsA ? t.b.pole : t.a.pole,
        }
      : null;
  })
  .filter(Boolean)
  .sort((a, b) => a.org.name.localeCompare(b.org.name));

const multiTension = companies.filter(
  (c) => (tensionCountBySlug[c.slug] || 0) >= 2
).length;

const craftTagged = companies.filter((c) => craftFor(c.slug)).length;
---

<Base
  title="Gaps"
  description="What the atlas deliberately leaves off the map — weak holds, unset craft leans, and orgs argued only once."
>
  <section class="gaps-hero">
    <p class="section-label">Honesty mode</p>
    <h1>Gaps</h1>
    <p class="lede">
      {gaps._meta?.blurb || "Absence is part of the map."}
      {" "}
      {atlas.company_count} published orgs · {held.length} held weak ·{" "}
      {unsetCraft.length} without craft lean · {singleTension.length} in only one
      tension · {multiTension} in 2+.
    </p>
    <p class="hero-actions">
      <a class="text-link" href="#held">Held weak</a>
      <a class="text-link" href="#craft">Unset craft</a>
      <a class="text-link" href="#thin">Thin coverage</a>
      <a class="text-link" href="/desk">Print desk cards</a>
    </p>
  </section>

  <section class="gaps-section" id="held">
    <p class="section-label">Held weak</p>
    <h2>Off the map on purpose</h2>
    <p class="gaps-section__lede">
      These briefs exist in git for rework. They fail the twenty-second
      distinguishability test or aren’t a stable product-org signal.
    </p>
    {
      Object.entries(heldByBucket).map(([bucket, rows]) => (
        <div class="gaps-bucket">
          <h3>
            {bucketLabels[bucket] || bucket}
            <span class="gaps-bucket__count">{rows.length}</span>
          </h3>
          <ul class="gaps-list">
            {rows.map((h) => (
              <li>
                <a href={`/episodes/${h.slug}`}>
                  <strong>{h.title}</strong>
                </a>
                {h.thesis ? <p class="gaps-list__thesis">{h.thesis}</p> : null}
                <p class="gaps-list__why">{h.why}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="gaps-section" id="craft">
    <p class="section-label">Craft lean</p>
    <h2>Unset on purpose</h2>
    <p class="gaps-section__lede">
      Only {craftTagged} of {companies.length} published orgs have a craft lean.
      Silence means the interview doesn’t clearly land eng vs PM vs design
      ownership — not that we forgot to tag them.
    </p>
    <div class="gaps-chips">
      {
        unsetCraft.map((c) => (
          <a class="peer-chip" href={`/companies/${c.slug}`}>
            <strong>{c.name}</strong>
            <span>{c.stage || "—"}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="gaps-section" id="thin">
    <p class="section-label">Thin coverage</p>
    <h2>Only one argument so far</h2>
    <p class="gaps-section__lede">
      Every published org is in at least one tension. These {singleTension.length}{" "}
      only have one opponent — useful steals, but the atlas hasn’t stress-tested
      them against a second bet yet. Open the tension, print desk cards, or steal
      another bet in the same lens.
    </p>
    <ul class="gaps-thin-list">
      {
        singleTension.map((row) => (
          <li class="gaps-thin">
            <div class="gaps-thin__head">
              <a href={`/companies/${row.org.slug}`}>
                <strong>{row.org.name}</strong>
              </a>
              <span class="gaps-thin__vs">
                {row.selfPole} vs {row.otherPole}
              </span>
              —{" "}
              <a href={`/companies/${row.other.slug}`}>{row.other.name}</a>
            </div>
            <p class="gaps-thin__axis">
              <a href={`/tensions/${row.tension.id}?you=${row.you}`}>
                {row.tension.axis}
              </a>
            </p>
            <p class="hero-actions gaps-thin__actions">
              <a
                class="text-link"
                href={`/tensions/${row.tension.id}?you=${row.you}`}
              >
                Open tension
              </a>
              <a
                class="text-link"
                href={`/compare?a=${row.org.slug}&b=${row.other.slug}`}
              >
                Compare
              </a>
              <a
                class="text-link"
                href={`/desk?a=${row.org.slug}&b=${row.other.slug}`}
              >
                Desk
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="tensions-foot">
    <a href="/steal">Steal a bet</a>
    ·
    <a href="/pole">Which pole are you?</a>
    ·
    <a href="/tensions">Tensions</a>
    ·
    <a href="/browse?status=weak">Browse weak cards</a>
    ·
    <a href="/?tension=single">Map · 1 tension</a>
    ·
    <a href="/">Map</a>
  </p>
</Base>
