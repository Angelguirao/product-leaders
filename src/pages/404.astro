---
import Base from "../layouts/Base.astro";
---

<Base
  title="Not found"
  description="That page isn’t on the Product Leaders Atlas."
>
  <section class="hero hero--argument">
    <p class="section-label">404</p>
    <h1>This page isn’t on the map</h1>
    <p>
      The URL may be old, mistyped, or pointing at a card that isn’t published
      yet.
    </p>
    <p class="hero-actions">
      <a class="hero-cta" href="/steal?go=1">Steal a bet →</a>
      <a class="text-link" href="/">Map</a>
      <a class="text-link" href="/tensions">Tensions</a>
      <a class="text-link" href="/browse">Cards</a>
    </p>
  </section>
</Base>
