---
import Base from "../../layouts/Base.astro";
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import Mermaid from "../../components/Mermaid.astro";
import ShareRow from "../../components/ShareRow.astro";
import companies from "../../data/companies.json";
import tensions from "../../data/tensions.json";
import episodes from "../../data/episodes.json";
import { parseOwnershipLine, practiceShort } from "../../lib/format.mjs";

export function getStaticPaths() {
  const episodesDir = join(process.cwd(), "episodes");
  const files = readdirSync(episodesDir).filter((f) => f.endsWith(".md"));
  return files.map((file) => {
    const slug = file.replace(/\.md$/, "");
    const raw = readFileSync(join(episodesDir, file), "utf8");
    return { params: { slug }, props: { raw, slug } };
  });
}

const { raw, slug } = Astro.props;

function parseFrontmatter(text) {
  if (!text.startsWith("---")) return { meta: {}, body: text };
  const end = text.indexOf("\n---", 4);
  if (end < 0) return { meta: {}, body: text };
  const fm = text.slice(4, end).trim();
  const body = text.slice(end + 4).replace(/^\r?\n/, "");
  const meta = {};
  for (const line of fm.split(/\r?\n/)) {
    const m = line.match(/^([a-zA-Z0-9_]+):\s*(.*)$/);
    if (!m) continue;
    let val = m[2].trim();
    if (val.startsWith("[") && val.endsWith("]")) {
      meta[m[1]] = [...val.matchAll(/"((?:\\.|[^"])*)"/g)].map((x) => x[1]);
    } else if (
      (val.startsWith('"') && val.endsWith('"')) ||
      (val.startsWith("'") && val.endsWith("'"))
    ) {
      meta[m[1]] = val.slice(1, -1);
    } else if (val === "null") {
      meta[m[1]] = null;
    } else {
      meta[m[1]] = val;
    }
  }
  return { meta, body };
}

function section(body, heading) {
  const re = new RegExp(
    `## ${heading}\\s*\\n([\\s\\S]*?)(?=\\n## |$)`,
    "i"
  );
  const m = body.match(re);
  return m ? m[1].trim() : "";
}

function firstMermaid(text) {
  const m = String(text || "").match(/```mermaid\s*([\s\S]*?)```/i);
  return m ? m[1].trim() : null;
}

function bulletLines(text) {
  return String(text || "")
    .split(/\n/)
    .map((l) => l.replace(/^[*+-]\s+/, "").trim())
    .filter((l) => l && !l.startsWith("_") && !l.startsWith("```"));
}

const { meta, body } = parseFrontmatter(raw);
const indexed = episodes.find((e) => e.slug === slug);
const thesisMatch = body.match(/## Thesis\s*\n+([^\n#]+)/i);
const thesis =
  indexed?.thesis || (thesisMatch ? thesisMatch[1].trim() : "") || "";
const companySlug = meta.company_slug || indexed?.company_slug || null;
const company = companySlug
  ? companies.find((c) => c.slug === companySlug)
  : null;

const relatedTension = company
  ? tensions.find(
      (t) => t.a.slug === company.slug || t.b.slug === company.slug
    )
  : null;
const you =
  relatedTension && company
    ? relatedTension.a.slug === company.slug
      ? "a"
      : "b"
    : null;

const ownershipRaw =
  indexed?.ownership ||
  bulletLines(section(body, "Ownership")) ||
  [];
const ownership = (Array.isArray(ownershipRaw) ? ownershipRaw : []).map(
  parseOwnershipLine
);
const loopMermaid =
  indexed?.loop_mermaid ||
  firstMermaid(section(body, "Operating loop")) ||
  firstMermaid(section(body, "Product workflow"));
const loopBullets = indexed?.loop_bullets || [];
const evidence = indexed?.evidence || bulletLines(section(body, "Evidence"));
const gaps = indexed?.gaps || bulletLines(section(body, "Gaps"));
const context = indexed?.context || section(body, "Context");
const status = meta.status || indexed?.status || "unknown";
const practices = meta.practices || indexed?.practices || [];

const compareHref = relatedTension
  ? `/compare?a=${relatedTension.a.slug}&b=${relatedTension.b.slug}`
  : company
    ? `/compare?a=${company.slug}`
    : "/compare";

const title = company?.name || meta.company || thesis || slug;
const shareText = thesis
  ? `${title}: ${thesis}`
  : `Product Leaders card — ${title}`;
---

<Base
  title={title}
  description={thesis || (meta.company
    ? `Operating-model map for ${meta.company}.`
    : "Episode operating-model map.")}
  ogImage={company ? `/og/${company.slug}.png` : "/og.png"}
>
  <article class="company-os">
    <header class="company-os__head">
      <p class="section-label">
        Episode card
        {status !== "published" ? ` · ${status}` : ""}
      </p>
      <h1>{thesis || title}</h1>
      <p class="lede">
        {
          company ? (
            <a href={`/companies/${company.slug}`}>{company.name}</a>
          ) : meta.company ? (
            meta.company
          ) : null
        }
        {meta.guest ? ` · ${meta.guest}` : ""}
        {meta.role ? ` · ${meta.role}` : ""}
        {company?.stage || meta.stage ? ` · ${company?.stage || meta.stage}` : ""}
      </p>
      {
        meta.title ? (
          <p class="company-os__source">Source episode: {meta.title}</p>
        ) : null
      }
      {
        practices.length ? (
          <div class="tags" style="margin: 1rem 0 0;">
            {practices.map((p) => (
              <a class="tag" href={`/practices/${p}`} title={p}>
                {practiceShort(p)}
              </a>
            ))}
          </div>
        ) : null
      }
      <p class="company-os__actions hero-actions">
        {
          relatedTension && you ? (
            <a
              class="hero-cta"
              href={`/tensions/${relatedTension.id}?you=${you}`}
            >
              Steal this bet →
            </a>
          ) : (
            <a class="hero-cta" href="/steal?go=1">Steal a bet →</a>
          )
        }
        {
          company ? (
            <a class="text-link" href={`/companies/${company.slug}`}>
              Company card
            </a>
          ) : null
        }
        <a class="text-link" href={compareHref}>Compare</a>
        {
          company ? (
            <a class="text-link" href={`/desk?a=${company.slug}`}>Desk</a>
          ) : null
        }
        <ShareRow text={shareText} copyId="episode-copy" />
      </p>
    </header>

    {
      context ? (
        <>
          <h2>Context</h2>
          <p>{context}</p>
        </>
      ) : null
    }

    <h2>Operating loop</h2>
    {loopMermaid ? <Mermaid code={loopMermaid} /> : null}
    {
      !loopMermaid && loopBullets.length ? (
        <ul>
          {loopBullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      ) : null
    }
    {
      !loopMermaid && !loopBullets.length ? (
        <p class="empty">No operating loop captured yet.</p>
      ) : null
    }

    {
      ownership.length ? (
        <>
          <h2>Ownership</h2>
          <ul class="ownership-list">
            {ownership.map((row) =>
              row.label ? (
                <li>
                  <strong>{row.label}</strong> {row.text}
                </li>
              ) : (
                <li>{row.text}</li>
              )
            )}
          </ul>
        </>
      ) : null
    }

    {
      evidence.length ? (
        <>
          <h2>Evidence</h2>
          <ul>
            {evidence.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </>
      ) : null
    }

    {
      gaps.length ? (
        <>
          <h2>Gaps</h2>
          <ul>
            {gaps.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </>
      ) : null
    }

    <p class="company-os__source">
      {
        meta.url || indexed?.url ? (
          <a href={meta.url || indexed.url} rel="noopener">
            Watch interview
          </a>
        ) : null
      }
      {(meta.url || indexed?.url) && company ? " · " : null}
      {
        company ? (
          <a href={`/companies/${company.slug}`}>Open company card</a>
        ) : null
      }
    </p>
  </article>
</Base>
