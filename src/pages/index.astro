---
import Base from "../layouts/Base.astro";
import Mermaid from "../components/Mermaid.astro";
import atlas from "../data/atlas.json";

const companies = atlas.companies || [];
const practices = Object.values(atlas.practices || {}).filter(
  (p) => p.companies?.length
);
const stages = [
  ...new Set(companies.map((c) => c.stage || "other")),
].sort((a, b) => {
  const order = ["early", "growth", "scale", "enterprise", "agency", "other"];
  return order.indexOf(a) - order.indexOf(b);
});
const byStage = {};
for (const c of companies) {
  const s = c.stage || "other";
  if (!byStage[s]) byStage[s] = [];
  byStage[s].push(c);
}
const stageOrder = ["early", "growth", "scale", "enterprise", "agency", "other"];

const featured = [...companies]
  .filter((c) => (c.thesis || "").length > 80)
  .sort((a, b) => (b.thesis?.length || 0) - (a.thesis?.length || 0))
  .slice(0, 6);

const companiesJson = JSON.stringify(
  companies.map((c) => ({
    slug: c.slug,
    name: c.name,
    stage: c.stage || "other",
    practices: c.practices || [],
    thesis: c.thesis || "",
    guest: c.guests?.[0]
      ? `${c.guests[0].name}${c.guests[0].role ? ` · ${c.guests[0].role}` : ""}`
      : "",
  }))
);
---

<Base
  title="Product Leaders Atlas"
  description="How product teams operate — one thesis per company. Compare ownership, loops, and stage."
>
  <section class="hero">
    <h1>Product-org map</h1>
    <p>
      How real product teams operate — one thesis per company, seeded from Dani
      Diestre’s Product Leaders interviews. Compare ownership, loops, and stage.
      All cards in English.
    </p>
    <div class="stats">
      <div>
        <strong>{atlas.company_count}</strong>
        orgs mapped
      </div>
      <div>
        <strong>{atlas.published_count ?? atlas.briefed_count}</strong>
        published cards
      </div>
      <div>
        <strong>{atlas.weak_count || 0}</strong>
        held as weak
      </div>
    </div>
    <p class="hero-actions">
      <a class="text-link" href="/compare">Compare two or three orgs →</a>
      <a class="text-link" href="/docs/how-to-read">How to read a card</a>
      <a class="text-link" href="/docs/about">About & share</a>
    </p>
  </section>

  {
    featured.length ? (
      <section class="featured-strip">
        <p class="section-label">Sharp theses</p>
        <div class="featured-strip__row">
          {featured.map((c) => (
            <a class="peer-chip" href={`/companies/${c.slug}`}>
              <strong>{c.name}</strong>
              <span>{c.thesis}</span>
            </a>
          ))}
        </div>
      </section>
    ) : null
  }

  {
    atlas.map_mermaid && companies.length ? (
      <section class="atlas-map">
        <p class="section-label">Orgs × practices</p>
        <Mermaid code={atlas.map_mermaid} clickable={true} />
        <p class="atlas-map__hint">Click a company or practice node to open it.</p>
      </section>
    ) : null
  }

  <section class="map-filters" id="map-filters" data-companies={companiesJson}>
    <p class="section-label">Filter the map</p>
    <div class="filter-row">
      <label class="filter-search">
        Search
        <input
          id="filter-q"
          type="search"
          name="q"
          placeholder="Company, guest, thesis…"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <label>
        Stage
        <select id="filter-stage" name="stage">
          <option value="">All stages</option>
          {stages.map((s) => (
            <option value={s}>{s}</option>
          ))}
        </select>
      </label>
      <label>
        Practice
        <select id="filter-practice" name="practice">
          <option value="">All practices</option>
          {practices.map((p) => (
            <option value={p.key}>{p.label}</option>
          ))}
        </select>
      </label>
      <button type="button" id="filter-reset" class="filter-reset">
        Reset
      </button>
    </div>
    <p class="filter-count" id="filter-count" hidden></p>
  </section>

  {
    companies.length === 0 ? (
      <p class="empty">
        No published cards yet. Rebrief with the thesis-first schema, then{" "}
        <code>npm run index</code>.
      </p>
    ) : (
      <div id="company-map">
        <p class="empty filter-empty" id="filter-empty" hidden>
          No orgs match. Clear search or{" "}
          <button type="button" class="text-link" id="filter-empty-reset">
            reset filters
          </button>
          .
        </p>
        {stageOrder
          .filter((s) => byStage[s]?.length)
          .map((stage) => (
            <section class="stage-block" data-stage={stage} style="margin-bottom: 2.5rem;">
              <p class="section-label">{stage}</p>
              <div class="company-grid">
                {byStage[stage].map((c) => (
                  <a
                    class="company-cell"
                    href={`/companies/${c.slug}`}
                    data-slug={c.slug}
                    data-stage={c.stage || "other"}
                    data-practices={(c.practices || []).join(" ")}
                    data-search={[
                      c.name,
                      c.slug,
                      c.thesis,
                      ...(c.guests || []).flatMap((g) => [g.name, g.role]),
                      ...(c.practices || []),
                    ]
                      .filter(Boolean)
                      .join(" ")
                      .toLowerCase()}
                  >
                    <h2>{c.name}</h2>
                    <div class="meta">
                      {c.guests?.[0]
                        ? `${c.guests[0].name}${c.guests[0].role ? ` · ${c.guests[0].role}` : ""}`
                        : "—"}
                    </div>
                    {c.thesis ? <p>{c.thesis}</p> : null}
                    {c.practices?.length ? (
                      <div class="tags">
                        {c.practices.slice(0, 4).map((p) => (
                          <span class="tag">{p}</span>
                        ))}
                      </div>
                    ) : null}
                  </a>
                ))}
              </div>
            </section>
          ))}
      </div>
    )
  }

  {
    practices.length ? (
      <section style="margin-top: 1rem;">
        <p class="section-label">By practice</p>
        <div class="tags" style="gap: 0.75rem;">
          {practices.map((p) => (
            <a class="tag" href={`/practices/${p.key}`}>
              {p.label} ({p.companies.length})
            </a>
          ))}
        </div>
      </section>
    ) : null
  }
</Base>

<script>
  function resetFilters() {
    const q = /** @type {HTMLInputElement} */ (
      document.getElementById("filter-q")
    );
    const s = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-stage")
    );
    const p = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-practice")
    );
    if (q) q.value = "";
    if (s) s.value = "";
    if (p) p.value = "";
    applyFilters();
  }

  function applyFilters() {
    const stage = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-stage")
    )?.value;
    const practice = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-practice")
    )?.value;
    const q = (
      /** @type {HTMLInputElement} */ (document.getElementById("filter-q"))
        ?.value || ""
    )
      .trim()
      .toLowerCase();
    const cells = document.querySelectorAll(".company-cell");
    let visible = 0;
    cells.forEach((cell) => {
      const okStage = !stage || cell.getAttribute("data-stage") === stage;
      const practices = (cell.getAttribute("data-practices") || "").split(/\s+/);
      const okPractice = !practice || practices.includes(practice);
      const hay = cell.getAttribute("data-search") || "";
      const okQ = !q || hay.includes(q);
      const show = okStage && okPractice && okQ;
      cell.toggleAttribute("hidden", !show);
      if (show) visible++;
    });
    document.querySelectorAll(".stage-block").forEach((block) => {
      const any = block.querySelector(".company-cell:not([hidden])");
      block.toggleAttribute("hidden", !any);
    });
    const filtering = Boolean(stage || practice || q);
    const count = document.getElementById("filter-count");
    if (count) {
      count.hidden = !filtering;
      count.textContent = filtering
        ? `Showing ${visible} of ${cells.length} orgs`
        : "";
    }
    const empty = document.getElementById("filter-empty");
    if (empty) empty.hidden = !(filtering && visible === 0);
  }

  document.getElementById("filter-stage")?.addEventListener("change", applyFilters);
  document
    .getElementById("filter-practice")
    ?.addEventListener("change", applyFilters);
  document.getElementById("filter-q")?.addEventListener("input", applyFilters);
  document.getElementById("filter-reset")?.addEventListener("click", resetFilters);
  document
    .getElementById("filter-empty-reset")
    ?.addEventListener("click", resetFilters);
</script>
