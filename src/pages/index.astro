---
import Base from "../layouts/Base.astro";
import Mermaid from "../components/Mermaid.astro";
import atlas from "../data/atlas.json";
import tensions from "../data/tensions.json";
import themesData from "../data/tension-themes.json";
import {
  craftFor,
  craftLabels,
  craftBlurb,
  craftShort,
} from "../lib/craft.mjs";
import { practiceShort } from "../lib/format.mjs";

const companies = atlas.companies || [];
const bySlug = Object.fromEntries(companies.map((c) => [c.slug, c]));
const practices = Object.values(atlas.practices || {}).filter(
  (p) => p.companies?.length
);
const stages = [
  ...new Set(companies.map((c) => c.stage || "other")),
].sort((a, b) => {
  const order = ["early", "growth", "scale", "enterprise", "agency", "other"];
  return order.indexOf(a) - order.indexOf(b);
});
const byStage = {};
for (const c of companies) {
  const s = c.stage || "other";
  if (!byStage[s]) byStage[s] = [];
  byStage[s].push(c);
}
const stageOrder = ["early", "growth", "scale", "enterprise", "agency", "other"];

const craftLabelMap = craftLabels();
const craftOptions = Object.entries(craftLabelMap).map(([key, label]) => ({
  key,
  label,
  count: companies.filter((c) => craftFor(c.slug)?.lean === key).length,
}));

// Prefer the craft tension as the home argument
const spotlightTension =
  tensions
    .map((t) => {
      const a = bySlug[t.a.slug];
      const b = bySlug[t.b.slug];
      return a && b ? { ...t, aOrg: a, bOrg: b } : null;
    })
    .find((t) => t?.id === "product-engineering-vs-pm") ||
  tensions
    .map((t) => {
      const a = bySlug[t.a.slug];
      const b = bySlug[t.b.slug];
      return a && b ? { ...t, aOrg: a, bOrg: b } : null;
    })
    .find(Boolean);

const distinctivePractice = (p) =>
  !["discovery", "delivery"].includes(p);

const tensionCountBySlug = {};
for (const t of tensions) {
  tensionCountBySlug[t.a.slug] = (tensionCountBySlug[t.a.slug] || 0) + 1;
  tensionCountBySlug[t.b.slug] = (tensionCountBySlug[t.b.slug] || 0) + 1;
}

const freshTensions = (() => {
  const byId = Object.fromEntries(tensions.map((t) => [t.id, t]));
  const seen = new Set();
  const picked = [];
  const add = (id) => {
    if (picked.length >= 5 || seen.has(id) || id === spotlightTension?.id) return;
    const t = byId[id];
    if (!t) return;
    const a = bySlug[t.a.slug];
    const b = bySlug[t.b.slug];
    if (!a || !b) return;
    seen.add(id);
    picked.push({ ...t, aOrg: a, bOrg: b });
  };
  // One argument per lens, then fill from remaining theme ids
  for (const th of themesData.themes || []) {
    if (th.ids?.[0]) add(th.ids[0]);
  }
  for (const th of themesData.themes || []) {
    for (const id of th.ids || []) add(id);
  }
  return picked;
})();

---

<Base
  title="Product Leaders Atlas"
  description="See how real product orgs disagree — thesis, craft lean, and stage. English cards from Product Leaders interviews."
>
  <section class="hero hero--argument">
    <p class="section-label">Product Leaders Atlas</p>
    <h1>See how product orgs disagree</h1>
    <p>
      One sharp thesis per company. Compare ownership, craft, and stage — then
      steal the bet that fits. Seeded from Dani Diestre’s interviews; all cards
      in English.
    </p>
    <p class="hero-actions">
      <a class="hero-cta" href="/steal?go=1">Steal a bet →</a>
      <a class="text-link" href="/tensions">Browse tensions</a>
      <a class="text-link" href="/pole">Which pole are you?</a>
      <a class="text-link" href="#map">Map</a>
    </p>
    <p class="hero-meta">
      {atlas.company_count} orgs · {tensions.length} tensions ·{" "}
      {craftOptions.reduce((n, o) => n + o.count, 0)} with a craft lean ·{" "}
      {atlas.weak_count || 0} held weak
    </p>
  </section>

  {
    spotlightTension ? (
      <section class="tension-spotlight tension-spotlight--hero">
        <p class="section-label">Start here · stealable argument</p>
        <h2 class="tension-spotlight__axis">
          <a href={`/tensions/${spotlightTension.id}`}>{spotlightTension.axis}</a>
        </h2>
        <p class="tension-spotlight__note">{spotlightTension.note}</p>
        <div class="tension__duel">
          <a class="tension__pole" href={`/companies/${spotlightTension.a.slug}`}>
            <p class="tension__pole-label">{spotlightTension.a.pole}</p>
            <h3>{spotlightTension.aOrg.name}</h3>
            {craftFor(spotlightTension.a.slug) ? (
              <span class={`craft-pill craft-pill--${craftFor(spotlightTension.a.slug).lean}`}>
                {craftShort(craftFor(spotlightTension.a.slug).lean)}
              </span>
            ) : null}
            <p class="tension__thesis">{spotlightTension.aOrg.thesis}</p>
          </a>
          <div class="tension__vs" aria-hidden="true">
            <span>vs</span>
          </div>
          <a
            class="tension__pole tension__pole--b"
            href={`/companies/${spotlightTension.b.slug}`}
          >
            <p class="tension__pole-label">{spotlightTension.b.pole}</p>
            <h3>{spotlightTension.bOrg.name}</h3>
            {craftFor(spotlightTension.b.slug) ? (
              <span class={`craft-pill craft-pill--${craftFor(spotlightTension.b.slug).lean}`}>
                {craftShort(craftFor(spotlightTension.b.slug).lean)}
              </span>
            ) : null}
            <p class="tension__thesis">{spotlightTension.bOrg.thesis}</p>
          </a>
        </div>
        <p class="hero-actions" style="margin-top: 1rem;">
          <a class="hero-cta" href={`/tensions/${spotlightTension.id}`}>
            Steal this bet →
          </a>
          <a class="text-link" href="/pole">Which pole are you?</a>
          <a
            class="text-link"
            href={`/compare?a=${spotlightTension.a.slug}&b=${spotlightTension.b.slug}`}
          >
            Compare the pair
          </a>
          <a class="text-link" href="/tensions">All tensions</a>
        </p>
      </section>
    ) : null
  }

  {
    freshTensions.length ? (
      <section class="fresh-tensions" data-pagefind-ignore>
        <p class="section-label">Across lenses</p>
        <div class="fresh-tensions__row">
          {freshTensions.map((t) => (
            <a class="fresh-tension" href={`/tensions/${t.id}`}>
              <span class="fresh-tension__axis">{t.axis}</span>
              <span class="fresh-tension__poles">
                {t.aOrg.name} vs {t.bOrg.name}
              </span>
            </a>
          ))}
        </div>
      </section>
    ) : null
  }

  <section class="map-filters" id="map" data-pagefind-ignore>
    <p class="section-label">Map</p>
    <p class="map-lede">
      Filter by stage or craft lean. {craftBlurb()}
    </p>
    <div class="filter-row">
      <label class="filter-search">
        Search
        <input
          id="filter-q"
          type="search"
          name="q"
          placeholder="Company, guest, thesis…"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <label>
        Stage
        <select id="filter-stage" name="stage">
          <option value="">All stages</option>
          {stages.map((s) => (
            <option value={s}>{s}</option>
          ))}
        </select>
      </label>
      <label>
        Craft lean
        <select id="filter-craft" name="craft">
          <option value="">All / unset</option>
          {craftOptions.map((o) => (
            <option value={o.key}>
              {o.label} ({o.count})
            </option>
          ))}
          <option value="unset">Unset only</option>
        </select>
      </label>
      <label>
        Argument
        <select id="filter-tension" name="tension">
          <option value="">All orgs</option>
          <option value="single">In 1 tension only</option>
          <option value="multi">In 2+ tensions</option>
        </select>
      </label>
      <button type="button" id="filter-reset" class="filter-reset">
        Reset
      </button>
    </div>
    <p class="filter-count" id="filter-count" hidden></p>
  </section>

  {
    companies.length === 0 ? (
      <p class="empty">
        No published cards yet. Rebrief with the thesis-first schema, then{" "}
        <code>npm run index</code>.
      </p>
    ) : (
      <div id="company-map">
        <p class="empty filter-empty" id="filter-empty" hidden>
          No orgs match.{" "}
          <button type="button" class="text-link" id="filter-empty-reset">
            Reset filters
          </button>
          .
        </p>
        {stageOrder
          .filter((s) => byStage[s]?.length)
          .map((stage) => (
            <section class="stage-block" data-stage={stage} style="margin-bottom: 2.5rem;">
              <p class="section-label">{stage}</p>
              <div class="company-grid">
                {byStage[stage].map((c) => {
                  const craft = craftFor(c.slug);
                  const tags = (c.practices || []).filter(distinctivePractice).slice(0, 3);
                  const tCount = tensionCountBySlug[c.slug] || 0;
                  return (
                    <a
                      class="company-cell"
                      href={`/companies/${c.slug}`}
                      data-slug={c.slug}
                      data-stage={c.stage || "other"}
                      data-craft={craft?.lean || "unset"}
                      data-tensions={String(tCount)}
                      data-search={[
                        c.name,
                        c.slug,
                        c.thesis,
                        craft?.label,
                        craft?.lean,
                        ...(c.guests || []).flatMap((g) => [g.name, g.role]),
                        ...(c.practices || []),
                      ]
                        .filter(Boolean)
                        .join(" ")
                        .toLowerCase()}
                    >
                      <div class="company-cell__top">
                        <h2>{c.name}</h2>
                        <div class="company-cell__badges">
                          {tCount ? (
                            <span class="tension-count" title={`In ${tCount} tension${tCount === 1 ? "" : "s"}`}>
                              {tCount}×
                            </span>
                          ) : null}
                          {craft ? (
                            <span class={`craft-pill craft-pill--${craft.lean}`}>
                              {craftShort(craft.lean)}
                            </span>
                          ) : null}
                        </div>
                      </div>
                      <div class="meta">
                        {c.guests?.[0]
                          ? `${c.guests[0].name}${c.guests[0].role ? ` · ${c.guests[0].role}` : ""}`
                          : "—"}
                      </div>
                      {c.thesis ? <p>{c.thesis}</p> : null}
                      {tags.length ? (
                        <div class="tags">
                          {tags.map((p) => (
                            <span class="tag">{practiceShort(p)}</span>
                          ))}
                        </div>
                      ) : null}
                    </a>
                  );
                })}
              </div>
            </section>
          ))}
      </div>
    )
  }

  {
    atlas.map_mermaid && companies.length ? (
      <section class="atlas-map">
        <details class="atlas-map__details" open>
          <summary class="section-label">Orgs × practices graph</summary>
          <Mermaid code={atlas.map_mermaid} clickable={true} />
          <p class="atlas-map__hint">
            Click a company or practice node to open it. Prefer the filtered map
            above on small screens.
          </p>
        </details>
      </section>
    ) : null
  }

  {
    practices.length ? (
      <section style="margin-top: 1rem;">
        <p class="section-label">By practice</p>
        <div class="tags" style="gap: 0.75rem;">
          {practices.map((p) => (
            <a class="tag" href={`/practices/${p.key}`}>
              {p.label} ({p.companies.length})
            </a>
          ))}
        </div>
      </section>
    ) : null
  }
</Base>

<script>
  function syncUrl() {
    const stage = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-stage")
    )?.value;
    const craft = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-craft")
    )?.value;
    const tension = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-tension")
    )?.value;
    const q = (
      /** @type {HTMLInputElement} */ (document.getElementById("filter-q"))
        ?.value || ""
    ).trim();
    const url = new URL(window.location.href);
    const setOrDel = (key, val) => {
      if (val) url.searchParams.set(key, val);
      else url.searchParams.delete(key);
    };
    setOrDel("stage", stage || "");
    setOrDel("craft", craft || "");
    setOrDel("tension", tension || "");
    setOrDel("q", q);
    const next = url.pathname + (url.searchParams.toString() ? `?${url.searchParams}` : "") + url.hash;
    history.replaceState({}, "", next);
  }

  function resetFilters() {
    const q = /** @type {HTMLInputElement} */ (
      document.getElementById("filter-q")
    );
    const s = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-stage")
    );
    const c = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-craft")
    );
    const t = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-tension")
    );
    if (q) q.value = "";
    if (s) s.value = "";
    if (c) c.value = "";
    if (t) t.value = "";
    applyFilters();
  }

  function applyFilters() {
    const stage = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-stage")
    )?.value;
    const craft = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-craft")
    )?.value;
    const tension = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-tension")
    )?.value;
    const q = (
      /** @type {HTMLInputElement} */ (document.getElementById("filter-q"))
        ?.value || ""
    )
      .trim()
      .toLowerCase();
    const cells = document.querySelectorAll(".company-cell");
    let visible = 0;
    cells.forEach((cell) => {
      const okStage = !stage || cell.getAttribute("data-stage") === stage;
      const cellCraft = cell.getAttribute("data-craft") || "unset";
      const okCraft =
        !craft ||
        (craft === "unset" ? cellCraft === "unset" : cellCraft === craft);
      const tCount = Number(cell.getAttribute("data-tensions") || "0");
      const okTension =
        !tension ||
        (tension === "single"
          ? tCount === 1
          : tension === "multi"
            ? tCount >= 2
            : tension === "in"
              ? tCount >= 1
              : true);
      const hay = cell.getAttribute("data-search") || "";
      const okQ = !q || hay.includes(q);
      const show = okStage && okCraft && okTension && okQ;
      cell.toggleAttribute("hidden", !show);
      if (show) visible++;
    });
    document.querySelectorAll(".stage-block").forEach((block) => {
      const any = block.querySelector(".company-cell:not([hidden])");
      block.toggleAttribute("hidden", !any);
    });
    const filtering = Boolean(stage || craft || tension || q);
    const count = document.getElementById("filter-count");
    if (count) {
      count.hidden = !filtering;
      count.textContent = filtering
        ? `Showing ${visible} of ${cells.length} orgs`
        : "";
    }
    const empty = document.getElementById("filter-empty");
    if (empty) empty.hidden = !(filtering && visible === 0);
    syncUrl();
  }

  function hydrateFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const q = /** @type {HTMLInputElement} */ (
      document.getElementById("filter-q")
    );
    const s = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-stage")
    );
    const c = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-craft")
    );
    const t = /** @type {HTMLSelectElement} */ (
      document.getElementById("filter-tension")
    );
    if (q && params.has("q")) q.value = params.get("q") || "";
    if (s && params.has("stage")) {
      const v = params.get("stage") || "";
      if ([...s.options].some((o) => o.value === v)) s.value = v;
    }
    if (c && params.has("craft")) {
      const v = params.get("craft") || "";
      if ([...c.options].some((o) => o.value === v)) c.value = v;
    }
    if (t && params.has("tension")) {
      const v = params.get("tension") || "";
      if ([...t.options].some((o) => o.value === v)) t.value = v;
    }
  }

  hydrateFromUrl();
  applyFilters();

  document.getElementById("filter-stage")?.addEventListener("change", applyFilters);
  document.getElementById("filter-craft")?.addEventListener("change", applyFilters);
  document.getElementById("filter-tension")?.addEventListener("change", applyFilters);
  document.getElementById("filter-q")?.addEventListener("input", applyFilters);
  document.getElementById("filter-reset")?.addEventListener("click", resetFilters);
  document
    .getElementById("filter-empty-reset")
    ?.addEventListener("click", resetFilters);
</script>
