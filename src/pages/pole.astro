---
import Base from "../layouts/Base.astro";
import companies from "../data/companies.json";
import tensions from "../data/tensions.json";
import quiz from "../data/pole-quiz.json";
import { craftFor, craftShort, craftLabels } from "../lib/craft.mjs";

const bySlug = Object.fromEntries(companies.map((c) => [c.slug, c]));

const tensionPayload = tensions
  .map((t) => {
    const a = bySlug[t.a.slug];
    const b = bySlug[t.b.slug];
    if (!a || !b) return null;
    return {
      id: t.id,
      axis: t.axis,
      note: t.note,
      a: { ...t.a, name: a.name, thesis: a.thesis, stage: a.stage },
      b: { ...t.b, name: b.name, thesis: b.thesis, stage: b.stage },
    };
  })
  .filter(Boolean);

const craftPeers = {};
for (const c of companies) {
  const lean = craftFor(c.slug)?.lean;
  if (!lean) continue;
  if (!craftPeers[lean]) craftPeers[lean] = [];
  craftPeers[lean].push({ slug: c.slug, name: c.name });
}

const payload = JSON.stringify({
  questions: quiz.questions,
  tensions: tensionPayload,
  craftPeers,
  craftLabels: craftLabels(),
});
---

<Base
  title="Which pole are you?"
  description="Five forced choices. Land on one operating tension — and the product orgs that already live that bet."
>
  <section class="pole-hero">
    <p class="section-label">Diagnostic</p>
    <h1>Which pole are you?</h1>
    <p class="lede">{quiz.intro}</p>
  </section>

  <div class="pole-quiz" id="pole-root" data-payload={payload}>
    <div class="pole-progress" id="pole-progress" aria-live="polite"></div>

    <div class="pole-step" id="pole-step"></div>

    <div class="pole-result" id="pole-result" hidden></div>
  </div>
</Base>

<script>
  const root = document.getElementById("pole-root");
  if (!root) throw new Error("pole root missing");

  const data = JSON.parse(root.dataset.payload || "{}");
  const questions = data.questions || [];
  const tensionsById = Object.fromEntries(
    (data.tensions || []).map((t) => [t.id, t])
  );
  const craftPeers = data.craftPeers || {};
  const craftLabels = data.craftLabels || {};

  const stepEl = document.getElementById("pole-step");
  const resultEl = document.getElementById("pole-result");
  const progressEl = document.getElementById("pole-progress");

  /** @type {{ tension: string, side: string }[]} */
  let answers = [];
  let index = 0;

  function score() {
    /** @type {Record<string, { a: number, b: number, total: number }>} */
    const tally = {};
    for (const ans of answers) {
      if (!tally[ans.tension]) tally[ans.tension] = { a: 0, b: 0, total: 0 };
      tally[ans.tension][ans.side]++;
      tally[ans.tension].total++;
    }
    const ranked = Object.entries(tally).sort((x, y) => {
      if (y[1].total !== x[1].total) return y[1].total - x[1].total;
      return Math.max(y[1].a, y[1].b) - Math.max(x[1].a, x[1].b);
    });
    const [tensionId, counts] = ranked[0];
    const side = counts.a >= counts.b ? "a" : "b";
    return { tensionId, side, ranked };
  }

  function renderProgress() {
    if (!progressEl) return;
    if (index >= questions.length) {
      progressEl.textContent = "Your pole";
      return;
    }
    progressEl.textContent = `Question ${index + 1} of ${questions.length}`;
  }

  function pick(side) {
    const q = questions[index];
    const choice = q[side];
    answers.push({ tension: choice.tension, side: choice.side });
    index += 1;
    if (index >= questions.length) {
      showResult();
    } else {
      renderQuestion();
    }
  }

  function renderQuestion() {
    const q = questions[index];
    if (!stepEl || !resultEl) return;
    resultEl.hidden = true;
    stepEl.hidden = false;
    renderProgress();
    stepEl.innerHTML = `
      <h2 class="pole-q">${escapeHtml(q.prompt)}</h2>
      <div class="pole-choices" role="group" aria-label="Choose a pole">
        <button type="button" class="pole-choice" data-side="a">
          <span class="pole-choice__tag">Pole A</span>
          <span class="pole-choice__label">${escapeHtml(q.a.label)}</span>
        </button>
        <button type="button" class="pole-choice pole-choice--b" data-side="b">
          <span class="pole-choice__tag">Pole B</span>
          <span class="pole-choice__label">${escapeHtml(q.b.label)}</span>
        </button>
      </div>
      ${
        index > 0
          ? `<button type="button" class="text-link pole-back" id="pole-back">← Back</button>`
          : ""
      }
    `;
    stepEl.querySelectorAll("[data-side]").forEach((btn) => {
      btn.addEventListener("click", () =>
        pick(/** @type {HTMLElement} */ (btn).dataset.side)
      );
    });
    const back = document.getElementById("pole-back");
    if (back) {
      back.addEventListener("click", () => {
        answers.pop();
        index = Math.max(0, index - 1);
        renderQuestion();
      });
    }
  }

  /**
   * @param {{ tensionId: string, side: string, ranked?: [string, { a: number, b: number, total: number }][] } | null} forced
   */
  function showResult(forced = null) {
    const scored = forced || score();
    const tensionId = scored.tensionId;
    const side = scored.side;
    const ranked = scored.ranked || [[tensionId, { a: 1, b: 0, total: 1 }]];
    const t = tensionsById[tensionId];
    if (!stepEl || !resultEl || !t) return;
    stepEl.hidden = true;
    resultEl.hidden = false;
    renderProgress();

    const you = t[side];
    const otherSide = side === "a" ? "b" : "a";
    const other = t[otherSide];
    const lean = Object.keys(craftPeers).find((k) =>
      (craftPeers[k] || []).some((p) => p.slug === you.slug)
    );
    const peers = lean
      ? (craftPeers[lean] || []).filter((p) => p.slug !== you.slug).slice(0, 4)
      : [];

    const alt = ranked
      .slice(1, 3)
      .map(([id]) => tensionsById[id])
      .filter(Boolean);

    const sharePath = `/pole?tension=${encodeURIComponent(tensionId)}&side=${side}`;
    const tensionPath = `/tensions/${tensionId}?you=${side}`;
    history.replaceState({}, "", sharePath);

    resultEl.innerHTML = `
      <p class="section-label">You lean toward</p>
      <h2 class="pole-result__axis">${escapeHtml(t.axis)}</h2>
      <p class="pole-result__note">${escapeHtml(t.note)}</p>

      <div class="tension__duel pole-result__duel">
        <a class="tension__pole ${side === "a" ? "pole-result__you" : ""}" href="/companies/${t.a.slug}">
          <p class="tension__pole-label">${side === "a" ? "Your pole · " : ""}${escapeHtml(t.a.pole)}</p>
          <h3>${escapeHtml(t.a.name)}</h3>
          <p class="tension__thesis">${escapeHtml(t.a.thesis || "")}</p>
        </a>
        <div class="tension__vs" aria-hidden="true"><span>vs</span></div>
        <a class="tension__pole tension__pole--b ${side === "b" ? "pole-result__you" : ""}" href="/companies/${t.b.slug}">
          <p class="tension__pole-label">${side === "b" ? "Your pole · " : ""}${escapeHtml(t.b.pole)}</p>
          <h3>${escapeHtml(t.b.name)}</h3>
          <p class="tension__thesis">${escapeHtml(t.b.thesis || "")}</p>
        </a>
      </div>

      <p class="pole-result__steal">
        Steal from <strong>${escapeHtml(you.name)}</strong>
        (“${escapeHtml(you.pole)}”), then argue with
        <a href="/companies/${other.slug}">${escapeHtml(other.name)}</a>
        before you copy blindly.
      </p>

      <p class="hero-actions pole-result__actions">
        <a class="hero-cta" href="${tensionPath}">Steal this bet →</a>
        <a class="text-link" href="/compare?a=${t.a.slug}&amp;b=${t.b.slug}">Compare the pair</a>
        <button type="button" class="text-link" id="pole-copy" data-url="${escapeHtml(sharePath)}">Copy result link</button>
        <a class="text-link" id="pole-share-x" href="#" target="_blank" rel="noopener noreferrer">Share on X</a>
        <a class="text-link" id="pole-share-li" href="#" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </p>

      ${
        peers.length
          ? `<section class="pole-peers">
              <p class="section-label">Same craft lean · ${escapeHtml(craftLabels[lean] || lean)}</p>
              <div class="compare-presets__row">
                ${peers
                  .map(
                    (p) =>
                      `<a class="peer-chip" href="/companies/${p.slug}">${escapeHtml(p.name)}</a>`
                  )
                  .join("")}
              </div>
            </section>`
          : ""
      }

      ${
        alt.length
          ? `<section class="pole-alts">
              <p class="section-label">Also in your answers</p>
              <ul class="pole-alts__list">
                ${alt
                  .map(
                    (a) =>
                      `<li><a href="/tensions/${a.id}">${escapeHtml(a.axis)}</a></li>`
                  )
                  .join("")}
              </ul>
            </section>`
          : ""
      }

      <p class="pole-restart">
        <button type="button" class="filter-reset" id="pole-restart">Retake</button>
      </p>
    `;

    document.getElementById("pole-restart")?.addEventListener("click", () => {
      answers = [];
      index = 0;
      history.replaceState({}, "", "/pole");
      renderQuestion();
    });

    document.getElementById("pole-copy")?.addEventListener("click", async (e) => {
      const btn = /** @type {HTMLElement} */ (e.currentTarget);
      const path = btn.dataset.url || "";
      const full = new URL(path, window.location.origin).href;
      try {
        await navigator.clipboard.writeText(full);
        btn.textContent = "Copied";
        setTimeout(() => {
          btn.textContent = "Copy result link";
        }, 1600);
      } catch {
        btn.textContent = "Copy failed";
      }
    });

    const shareFull = new URL(sharePath, window.location.origin).href;
    const shareText = `I lean “${you.pole}” on ${t.axis} — Product Leaders Atlas`;
    const x = document.getElementById("pole-share-x");
    const li = document.getElementById("pole-share-li");
    if (x instanceof HTMLAnchorElement) {
      x.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareFull)}`;
    }
    if (li instanceof HTMLAnchorElement) {
      li.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareFull)}`;
    }
  }

  function escapeHtml(s) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  // Deep link: ?tension=&side=
  const params = new URLSearchParams(window.location.search);
  const deepT = params.get("tension");
  const deepS = params.get("side");
  if (deepT && tensionsById[deepT] && (deepS === "a" || deepS === "b")) {
    index = questions.length;
    showResult({ tensionId: deepT, side: deepS });
  } else {
    renderQuestion();
  }
</script>
