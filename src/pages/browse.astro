---
import Base from "../layouts/Base.astro";
import episodes from "../data/episodes.json";
import companies from "../data/companies.json";
import { craftFor, craftShort, craftLabels } from "../lib/craft.mjs";

const companySlugs = new Set(companies.map((c) => c.slug));
const statuses = ["published", "weak", "stub"];
const counts = Object.fromEntries(
  statuses.map((s) => [s, episodes.filter((e) => e.status === s).length])
);
const craftLabelMap = craftLabels();
const craftOptions = Object.entries(craftLabelMap).map(([key, label]) => ({
  key,
  label,
  count: companies.filter((c) => craftFor(c.slug)?.lean === key).length,
}));

const rows = episodes.map((e) => {
  const slug = e.company_slug || null;
  const craft = slug ? craftFor(slug) : null;
  return {
    ...e,
    company_slug: slug,
    has_company: Boolean(slug && companySlugs.has(slug)),
    craft_lean: craft?.lean || "",
    craft_short: craft ? craftShort(craft.lean) : "",
  };
});
---

<Base
  title="Cards"
  description="All Product Leaders cards — English thesis-first notes from each interview."
>
  <div class="prose">
    <h1>Cards</h1>
    <p class="lede">
      Each card extracts how the guest’s company runs product — English thesis,
      loop, and ownership. Original episode titles stay as source labels.
    </p>
    <p class="hero-actions">
      <a class="hero-cta" href="/steal?go=1">Steal a bet →</a>
      <a class="text-link" href="/tensions">Browse tensions</a>
      <a class="text-link" href="/pole">Which pole are you?</a>
    </p>
  </div>

  <div class="browse-filters" id="browse-filters">
    <p class="section-label">Filter cards</p>
    <div class="filter-row">
      <label class="filter-search">
        Search
        <input
          id="browse-q"
          type="search"
          name="q"
          placeholder="Company, guest, thesis…"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <label>
        Status
        <select id="browse-status">
          <option value="published">Published ({counts.published || 0})</option>
          <option value="weak">Weak ({counts.weak || 0})</option>
          <option value="stub">Stub ({counts.stub || 0})</option>
          <option value="all">All ({episodes.length})</option>
        </select>
      </label>
      <label>
        Craft lean
        <select id="browse-craft">
          <option value="all">All leans</option>
          {
            craftOptions.map((o) => (
              <option value={o.key}>
                {o.label} ({o.count})
              </option>
            ))
          }
          <option value="unset">Unset</option>
        </select>
      </label>
      <button type="button" id="browse-reset" class="filter-reset">
        Reset
      </button>
    </div>
    <p class="filter-count" id="browse-count" hidden></p>
  </div>

  {
    rows.length === 0 ? (
      <p class="empty">No episodes processed yet.</p>
    ) : (
      <div id="browse-wrap">
        <p class="empty filter-empty" id="browse-empty" hidden>
          No cards match.{" "}
          <button type="button" class="text-link" id="browse-empty-reset">
            Reset filters
          </button>
          .
        </p>
        <ul class="episode-list" style="margin-top: 1.5rem;" id="browse-list">
          {rows.map((e) => (
            <li
              data-status={e.status || "unknown"}
              data-craft={e.craft_lean || "unset"}
              data-search={[
                e.company,
                e.guest,
                e.role,
                e.thesis,
                e.overview,
                e.title,
                e.slug,
                e.craft_short,
              ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase()}
            >
              <a
                href={
                  e.has_company
                    ? `/companies/${e.company_slug}`
                    : `/episodes/${e.slug}`
                }
              >
                <div class="meta">
                  {[e.company, e.guest, e.role, e.status, e.craft_short]
                    .filter(Boolean)
                    .join(" · ") || "—"}
                </div>
                <h3>{e.thesis || e.overview || e.company || "Untitled card"}</h3>
                {e.title ? <p class="source-title">Source: {e.title}</p> : null}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Base>

<script>
  function syncUrl() {
    const status =
      /** @type {HTMLSelectElement} */ (document.getElementById("browse-status"))
        ?.value || "published";
    const craft =
      /** @type {HTMLSelectElement} */ (document.getElementById("browse-craft"))
        ?.value || "all";
    const q = (
      /** @type {HTMLInputElement} */ (document.getElementById("browse-q"))
        ?.value || ""
    ).trim();
    const url = new URL(window.location.href);
    if (status && status !== "published") url.searchParams.set("status", status);
    else url.searchParams.delete("status");
    if (craft && craft !== "all") url.searchParams.set("craft", craft);
    else url.searchParams.delete("craft");
    if (q) url.searchParams.set("q", q);
    else url.searchParams.delete("q");
    const next =
      url.pathname +
      (url.searchParams.toString() ? `?${url.searchParams}` : "") +
      url.hash;
    history.replaceState({}, "", next);
  }

  function resetBrowse() {
    const q = /** @type {HTMLInputElement} */ (
      document.getElementById("browse-q")
    );
    const s = /** @type {HTMLSelectElement} */ (
      document.getElementById("browse-status")
    );
    const c = /** @type {HTMLSelectElement} */ (
      document.getElementById("browse-craft")
    );
    if (q) q.value = "";
    if (s) s.value = "published";
    if (c) c.value = "all";
    apply();
  }

  function apply() {
    const status =
      /** @type {HTMLSelectElement} */ (document.getElementById("browse-status"))
        ?.value || "published";
    const craft =
      /** @type {HTMLSelectElement} */ (document.getElementById("browse-craft"))
        ?.value || "all";
    const q = (
      /** @type {HTMLInputElement} */ (document.getElementById("browse-q"))
        ?.value || ""
    )
      .trim()
      .toLowerCase();
    const items = document.querySelectorAll("#browse-list > li");
    let visible = 0;
    items.forEach((li) => {
      const s = li.getAttribute("data-status") || "";
      const lean = li.getAttribute("data-craft") || "unset";
      const okStatus = status === "all" || s === status;
      const okCraft =
        craft === "all" ||
        (craft === "unset" ? lean === "unset" : lean === craft);
      const hay = li.getAttribute("data-search") || "";
      const okQ = !q || hay.includes(q);
      const show = okStatus && okCraft && okQ;
      li.toggleAttribute("hidden", !show);
      if (show) visible++;
    });
    const filtering = Boolean(q) || status !== "published" || craft !== "all";
    const count = document.getElementById("browse-count");
    if (count) {
      count.hidden = !filtering;
      count.textContent = filtering
        ? `Showing ${visible} of ${items.length} cards`
        : "";
    }
    const empty = document.getElementById("browse-empty");
    if (empty) empty.hidden = visible !== 0;
    syncUrl();
  }
  document.getElementById("browse-status")?.addEventListener("change", apply);
  document.getElementById("browse-craft")?.addEventListener("change", apply);
  document.getElementById("browse-q")?.addEventListener("input", apply);
  document.getElementById("browse-reset")?.addEventListener("click", resetBrowse);
  document
    .getElementById("browse-empty-reset")
    ?.addEventListener("click", resetBrowse);

  const params = new URLSearchParams(window.location.search);
  const statusParam = params.get("status");
  const craftParam = params.get("craft");
  const qParam = params.get("q");
  const statusSel = /** @type {HTMLSelectElement} */ (
    document.getElementById("browse-status")
  );
  const craftSel = /** @type {HTMLSelectElement} */ (
    document.getElementById("browse-craft")
  );
  const qSel = /** @type {HTMLInputElement} */ (
    document.getElementById("browse-q")
  );
  if (
    statusSel &&
    statusParam &&
    ["published", "weak", "stub", "all"].includes(statusParam)
  ) {
    statusSel.value = statusParam;
  }
  if (craftSel && craftParam) {
    if ([...craftSel.options].some((o) => o.value === craftParam)) {
      craftSel.value = craftParam;
    }
  }
  if (qSel && qParam) qSel.value = qParam;
  apply();
</script>
